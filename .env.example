# Copy to .env and fill in. Add a line here every time you add a key.
ANTHROPIC_API_KEY=
# Rust service port (server/). Default 3000.
PORT=3000
# Dashboard → Rust service URL. Leave empty in dev (uses the /api proxy).
VITE_API_URL=
# Redo API (phase 03). storeId used in /stores/{storeId}/... paths.
REDO_STORE_ID=
# Redo API secret. Rust service only, never sent to the dashboard.
REDO_API_SECRET=
# Redo client: mock (default, replays redo-fixtures/) or real.
REDO_MODE=mock
REDO_BASE=https://api.getredo.com/v2.2
# Session JWT signing secret. Missing = fixed dev secret + a warning.
BEEHIVE_JWT_SECRET=
# 1 = start with Kaylee's approved $50 session for muse-demo (dev and rehearsal only).
BEEHIVE_DEMO_SESSION=
